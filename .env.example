# Copy to .env and edit. Everything here has a working local default except the
# two secrets, which you must set before deploying.

# The one passcode everyone in the house types once, on each device.
HOUSE_PASSCODE=

# Signs the session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Shown in the header and the browser tab.
HOUSE_NAME=Casita

# Drives "today" for chore due dates -- set it to where the house actually is.
TIMEZONE=America/New_York

# Leave unset for local SQLite. A host that provisions Postgres will set it.
# DATABASE_URL=
